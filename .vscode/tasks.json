{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Preview Numatik",
			"type": "process",
			"command": "node",
			"args": [
				"node_modules/vite/bin/vite.js",
				"--config",
				"vite.config.ts",
				"--host",
				"0.0.0.0",
				"--port",
				"18860"
			],
			"options": {
				"cwd": "${workspaceFolder}/artifacts/numatik"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		}
	]
}